{
  "name": "opencode-chat",
  "displayName": "OpenCodeSpec Chat",
  "description": "GitHub Copilot-like chat using OpenCode as backend",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngDrew/OpenCodeSpec.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "ai",
    "chat",
    "copilot",
    "opencode"
  ],
  "activationEvents": [
    "onView:opencode.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencodespec.openChat",
        "title": "Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodespec.startServer",
        "title": "OpenCode: Start Local Server"
      },
      {
        "command": "opencodespec.stopServer",
        "title": "OpenCode: Stop Local Server"
      },
      {
        "command": "opencodespec.sendMessage",
        "title": "Send Message to Chat"
      },
      {
        "command": "opencodespec.helloWorld",
        "title": "Hello World"
      }
    ],
    "views": {
      "opencodeChat": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeChat",
          "title": "OpenCodeSpec Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "opencodespec.sendMessage",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.1.51",
    "@vscode/codicons": "^0.0.44"
  }
}
